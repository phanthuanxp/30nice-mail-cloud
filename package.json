{
  "name": "30nice-mail-cloud",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@30nice/portal",
    "dev:api": "npm run start:dev --workspace=@30nice/api",
    "build": "npm run build --workspace=@30nice/portal",
    "build:api": "npm run build --workspace=@30nice/api",
    "test:mailcow": "npm run build:api && node scripts/smoke-mailcow-adapter.cjs",
    "test:auth": "npm run build:api && node scripts/smoke-auth.cjs",
    "test:mailbox": "npm run build:api && node scripts/smoke-mailbox-operations.cjs",
    "test:domain": "npm run build:api && node scripts/smoke-domain-provisioning.cjs",
    "test:webmail-content": "npm run build:api && node scripts/smoke-webmail-content.cjs",
    "test:webmail-bcc": "npm run build:api && node scripts/smoke-webmail-bcc.cjs",
    "test:webmail-contacts": "npm run build:api && node scripts/smoke-webmail-contacts.cjs",
    "test:webmail-search": "npm run build:api && node scripts/smoke-webmail-search.cjs",
    "typecheck": "npm run typecheck --workspace=@30nice/portal && npm run typecheck --workspace=@30nice/api",
    "test": "npm run typecheck"
  }
}

